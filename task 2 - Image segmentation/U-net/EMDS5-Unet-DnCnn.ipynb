### Calculation of multiple assessment metrics (Dice coefficient, Jaccard index and recall rate)
import numpy as np

eps = 1e-6

dice_list = []
jaccard_list = []
recall_list = []

for i in range(all_preds.shape[0]):
    pred = all_preds[i]
    label = all_labels[i]
    intersection = (pred * label).sum().item()
    dice = 2 * intersection / (pred.sum().item() + label.sum().item() + eps)
    jaccard = intersection / (pred.sum().item() + label.sum().item() - intersection + eps)
    recall = intersection / (label.sum().item() + eps)
    dice_list.append(dice)
    jaccard_list.append(jaccard)
    recall_list.append(recall)

dice_array = np.array(dice_list)
jaccard_array = np.array(jaccard_list)
recall_array = np.array(recall_list)

avg_dice = np.mean(dice_array)
min_dice = np.min(dice_array)
max_dice = np.max(dice_array)

avg_jaccard = np.mean(jaccard_array)
min_jaccard = np.min(jaccard_array)
max_jaccard = np.max(jaccard_array)

avg_recall = np.mean(recall_array)
min_recall = np.min(recall_array)
max_recall = np.max(recall_array)

print("Average Dice: {:.2f}%".format(avg_dice * 100))
print("Lowest Dice: {:.2f}%".format(min_dice * 100))
print("Highest Dice: {:.2f}%".format(max_dice * 100))
print()
print("Average Jaccard (IoU): {:.2f}%".format(avg_jaccard * 100))
print("Lowest Jaccard (IoU): {:.2f}%".format(min_jaccard * 100))
print("Highest Jaccard (IoU): {:.2f}%".format(max_jaccard * 100))
print()
print("Average Recall: {:.2f}%".format(avg_recall * 100))
print("Lowest Recall: {:.2f}%".format(min_recall * 100))
print("Highest Recall: {:.2f}%".format(max_recall * 100))

### Find and show the best and worst performing samples
import torch
import numpy as np
import matplotlib.pyplot as plt
import itertools

eps = 1e-6

# Initialize polar values and record variables for corresponding samples
lowest_dice = 1.0
highest_dice = 0.0
lowest_iou = 1.0
highest_iou = 0.0
lowest_recall = 1.0
highest_recall = 0.0

lowest_dice_sample = None
highest_dice_sample = None
lowest_iou_sample = None
highest_iou_sample = None
lowest_recall_sample = None
highest_recall_sample = None

# Assume test_loader, device and model are defined and test_loader outputs (image, mask)
model.eval()
with torch.no_grad():
    for images, masks in test_loader:
        images = images.to(device)
        masks = masks.to(device)
        outputs = model(images)
        preds = torch.sigmoid(outputs)
        preds_bin = (preds > 0.5).float()
        for i in range(images.size(0)):
            pred = preds_bin[i].cpu()
            label = masks[i].cpu()
            image = images[i].cpu()
            # Calculate intersections and sums
            intersection = (pred * label).sum().item()
            pred_sum = pred.sum().item()
            label_sum = label.sum().item()
            # Dice: 2 * intersection / (pred_sum + label_sum)
            dice = 2 * intersection / (pred_sum + label_sum + eps)
            # IoU (Jaccard): intersection / (pred_sum + label_sum - intersection)
            iou = intersection / (pred_sum + label_sum - intersection + eps)
            # Recall: intersection / label_sum
            recall = intersection / (label_sum + eps)
            
            # Update minimum and maximum Dice
            if dice < lowest_dice:
                lowest_dice = dice
                lowest_dice_sample = (image, label, pred)
            if dice > highest_dice:
                highest_dice = dice
                highest_dice_sample = (image, label, pred)
            # Update minimum and maximum IoU
            if iou < lowest_iou:
                lowest_iou = iou
                lowest_iou_sample = (image, label, pred)
            if iou > highest_iou:
                highest_iou = iou
                highest_iou_sample = (image, label, pred)
            # Update minimum and maximum Recall
            if recall < lowest_recall:
                lowest_recall = recall
                lowest_recall_sample = (image, label, pred)
            if recall > highest_recall:
                highest_recall = recall
                highest_recall_sample = (image, label, pred)

def display_sample(sample, title, metric_value, metric_name):
    image, label, pred = sample
    image_np = image.permute(1, 2, 0).numpy()
    label_np = label.squeeze(0).numpy()
    pred_np = pred.squeeze(0).numpy()
    
    fig, axes = plt.subplots(1, 3, figsize=(15, 5))
    axes[0].imshow(image_np)
    axes[0].set_title(f"{title}\nInput Image\n{metric_name}: {metric_value*100:.2f}%")
    axes[0].axis("off")
    axes[1].imshow(label_np, cmap="gray")
    axes[1].set_title("Ground Truth")
    axes[1].axis("off")
    axes[2].imshow(pred_np, cmap="gray")
    axes[2].set_title("Prediction")
    axes[2].axis("off")
    plt.tight_layout()
    plt.show()

print("Dice Coefficient:")
print("Lowest Dice: {:.2f}%".format(lowest_dice*100))
display_sample(lowest_dice_sample, "Lowest Dice Sample", lowest_dice, "Dice")
print("Highest Dice: {:.2f}%".format(highest_dice*100))
display_sample(highest_dice_sample, "Highest Dice Sample", highest_dice, "Dice")

print("Jaccard (IoU):")
print("Lowest IoU: {:.2f}%".format(lowest_iou*100))
display_sample(lowest_iou_sample, "Lowest IoU Sample", lowest_iou, "IoU")
print("Highest IoU: {:.2f}%".format(highest_iou*100))
display_sample(highest_iou_sample, "Highest IoU Sample", highest_iou, "IoU")

print("Recall:")
print("Lowest Recall: {:.2f}%".format(lowest_recall*100))
display_sample(lowest_recall_sample, "Lowest Recall Sample", lowest_recall, "Recall")
print("Highest Recall: {:.2f}%".format(highest_recall*100))
display_sample(highest_recall_sample, "Highest Recall Sample", highest_recall, "Recall")

### Apply the trained U-net model to segment the original image
import os
import torch
import torch.nn as nn
import segmentation_models_pytorch as smp
from PIL import Image
from torchvision import transforms
import numpy as np

device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

transform = transforms.Compose([
    transforms.Resize((512, 512)),
    transforms.ToTensor()
])

model = smp.Unet(
    encoder_name="efficientnet-b3",
    encoder_weights="imagenet",
    in_channels=3,
    classes=1
)

model.load_state_dict(torch.load("model-denoised.pth", map_location=device, weights_only=True))
model = model.to(device)
model.eval()

input_base_dir = "../../EMDS-6/EMDS5-Original"    
output_base_dir = "PredictedMasks"  

if not os.path.exists(output_base_dir):
    os.makedirs(output_base_dir)

for folder in sorted(os.listdir(input_base_dir)):
    folder_path = os.path.join(input_base_dir, folder)
    if not os.path.isdir(folder_path):
        continue

    output_folder = os.path.join(output_base_dir, folder)
    if not os.path.exists(output_folder):
        os.makedirs(output_folder)
    
    for filename in sorted(os.listdir(folder_path)):
        if not filename.lower().endswith('.png'):
            continue
        image_path = os.path.join(folder_path, filename)
        image = Image.open(image_path).convert("RGB")
        image_tensor = transform(image)  # [C, H, W]
        input_tensor = image_tensor.unsqueeze(0).to(device)
        
        with torch.no_grad():
            output = model(input_tensor)
            pred = torch.sigmoid(output)
            pred_bin = (pred > 0.5).float().squeeze(0)  # [1, H, W]
        
        pred_np = pred_bin.squeeze(0).cpu().numpy()  # [H, W]
        pred_img = Image.fromarray((pred_np * 255).astype(np.uint8))

        output_filename = filename.replace(".png", "_pred.png")
        output_path = os.path.join(output_folder, output_filename)
        pred_img.save(output_path)

import os
from PIL import Image
import numpy as np

input_images_dir = "../../EMDS-6/EMDS5-Original"     
predicted_masks_dir = "PredictedMasks"    
output_dir = "SegmentedImages"          

if not os.path.exists(output_dir):
    os.makedirs(output_dir)

for folder in sorted(os.listdir(input_images_dir)):
    folder_path = os.path.join(input_images_dir, folder)
    if not os.path.isdir(folder_path):
        continue
    output_folder = os.path.join(output_dir, folder)
    if not os.path.exists(output_folder):
        os.makedirs(output_folder)
    
    image_files = sorted([f for f in os.listdir(folder_path) if f.lower().endswith('.png')])
    for filename in image_files:
        orig_path = os.path.join(folder_path, filename)
        pred_filename = filename.replace(".png", "_pred.png")
        mask_path = os.path.join(predicted_masks_dir, folder, pred_filename)
        
        try:
            orig_img = Image.open(orig_path).convert("RGB")
            mask_img = Image.open(mask_path).convert("L")
        except Exception as e:
            print(f"Error loading {filename} in folder {folder}: {e}")
            continue
        
        orig_img = orig_img.resize((512, 512))
        mask_img = mask_img.resize((512, 512))

        mask_np = np.array(mask_img)
        binary_mask = np.where(mask_np >= 128, 1, 0).astype(np.uint8)
        orig_np = np.array(orig_img)
        
        segmented_np = orig_np * binary_mask[..., np.newaxis]
        
        segmented_img = Image.fromarray(segmented_np)
        
        output_path = os.path.join(output_folder, filename.replace(".png", "_segmented.png"))
        segmented_img.save(output_path)
