# 2. Image segmentation to accurately delineate the regions of interest(U-net++)
## This code uses the UNet++ model for image segmentation tasks.
# Defining the UNet++ model
import torch
import torch.nn as nn
import torch.nn.functional as F

class ConvBlock(nn.Module):
    def __init__(self, in_ch, out_ch):
        super(ConvBlock, self).__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(in_ch, out_ch, kernel_size=3, padding=1),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True),
            nn.Conv2d(out_ch, out_ch, kernel_size=3, padding=1),
            nn.BatchNorm2d(out_ch),
            nn.ReLU(inplace=True)
        )

    def forward(self, x):
        return self.conv(x)


class UNetPlusPlus(nn.Module):
    def __init__(self, in_ch=1, out_ch=1, base_ch=64):
        super(UNetPlusPlus, self).__init__()

        self.pool = nn.MaxPool2d(2, 2)
        self.up = lambda x: F.interpolate(x, scale_factor=2, mode='bilinear', align_corners=True)

        # Encoder
        self.conv0_0 = ConvBlock(in_ch, base_ch)
        self.conv1_0 = ConvBlock(base_ch, base_ch * 2)
        self.conv2_0 = ConvBlock(base_ch * 2, base_ch * 4)
        self.conv3_0 = ConvBlock(base_ch * 4, base_ch * 8)
        self.conv4_0 = ConvBlock(base_ch * 8, base_ch * 16)

        # Decoder with nested connections
        self.conv0_1 = ConvBlock(base_ch + base_ch * 2, base_ch)
        self.conv1_1 = ConvBlock(base_ch * 2 + base_ch * 4, base_ch * 2)
        self.conv2_1 = ConvBlock(base_ch * 4 + base_ch * 8, base_ch * 4)
        self.conv3_1 = ConvBlock(base_ch * 8 + base_ch * 16, base_ch * 8)

        self.conv0_2 = ConvBlock(base_ch * 4, base_ch)
        self.conv1_2 = ConvBlock(base_ch * 8, base_ch * 2)
        self.conv2_2 = ConvBlock(base_ch * 16, base_ch * 4)

        self.conv0_3 = ConvBlock(base_ch * 5, base_ch)
        self.conv1_3 = ConvBlock(base_ch * 10, base_ch * 2)

        self.conv0_4 = ConvBlock(base_ch * 6, base_ch)

        self.final = nn.Conv2d(base_ch, out_ch, kernel_size=1)

    def forward(self, x):
        x0_0 = self.conv0_0(x)
        x1_0 = self.conv1_0(self.pool(x0_0))
        x2_0 = self.conv2_0(self.pool(x1_0))
        x3_0 = self.conv3_0(self.pool(x2_0))
        x4_0 = self.conv4_0(self.pool(x3_0))

        x0_1 = self.conv0_1(torch.cat([x0_0, self.up(x1_0)], 1))
        x1_1 = self.conv1_1(torch.cat([x1_0, self.up(x2_0)], 1))
        x2_1 = self.conv2_1(torch.cat([x2_0, self.up(x3_0)], 1))
        x3_1 = self.conv3_1(torch.cat([x3_0, self.up(x4_0)], 1))

        x0_2 = self.conv0_2(torch.cat([x0_0, x0_1, self.up(x1_1)], 1))
        x1_2 = self.conv1_2(torch.cat([x1_0, x1_1, self.up(x2_1)], 1))
        x2_2 = self.conv2_2(torch.cat([x2_0, x2_1, self.up(x3_1)], 1))

        x0_3 = self.conv0_3(torch.cat([x0_0, x0_1, x0_2, self.up(x1_2)], 1))
        x1_3 = self.conv1_3(torch.cat([x1_0, x1_1, x1_2, self.up(x2_2)], 1))

        x0_4 = self.conv0_4(torch.cat([x0_0, x0_1, x0_2, x0_3, self.up(x1_3)], 1))

        return torch.sigmoid(self.final(x0_4))
### The code is run twice by modifying the read file in order to train and validate the model using the image denoised with Dncnn and the image denoised with Trof respectively.
# Model training and evaluation
import os
import glob
import numpy as np
from PIL import Image
from tqdm import tqdm
import matplotlib.pyplot as plt
from sklearn.metrics import confusion_matrix
import random

import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import Dataset, DataLoader
from sklearn.model_selection import train_test_split

from unetpp_model import UNetPlusPlus  


class EMDataset(Dataset):
    def __init__(self, image_list, mask_list):
        self.image_list = image_list
        self.mask_list = mask_list

    def __getitem__(self, idx):
        img_path = self.image_list[idx]
        mask_path = self.mask_list[idx]

        image = Image.open(img_path).convert('L').resize((256, 256))
        mask = Image.open(mask_path).convert('L').resize((256, 256))

        image = np.array(image) / 255.0
        mask = np.array(mask) / 255.0

        image = torch.tensor(image, dtype=torch.float32).unsqueeze(0)
        mask = torch.tensor(mask, dtype=torch.float32).unsqueeze(0)

        return image, mask

    def __len__(self):
        return len(self.image_list)


def dice_loss(pred, target, smooth=1e-6):
    pred = pred.contiguous()
    target = target.contiguous()
    intersection = (pred * target).sum(dim=(2, 3))
    loss = 1 - ((2. * intersection + smooth) /
                (pred.sum(dim=(2, 3)) + target.sum(dim=(2, 3)) + smooth))
    return loss.mean()


def compute_iou(pred, gt):
    intersection = np.logical_and(pred, gt).sum()
    union = np.logical_or(pred, gt).sum()
    if union == 0:
        return 1.0 if intersection == 0 else 0.0
    return intersection / union


def train():
    # ========== Configuration path ==========
    # image_dir = "../../task 1 - Image denoising/EMDS5-Denoised-DnCnn"
    image_dir = "../../task 1 - Image denoising/EMDS5-Denoised-Trof"
    mask_dir = "../../EMDS-6/EMDS5-Ground Truth"
    original_dir = "../../EMDS-6/EMDS5-Original"
    # save_crop_dir = "EMDS5-Unetpp-DnCnn"
    save_crop_dir = "EMDS5-Unetpp-Trof"
    os.makedirs(save_crop_dir, exist_ok=True)

    # ========== Prepare data ==========
    all_images = sorted(glob.glob(os.path.join(image_dir, "**", "*.png"), recursive=True))
    all_masks = sorted(glob.glob(os.path.join(mask_dir, "**", "*.png"), recursive=True))

    train_imgs, _, train_masks, _ = train_test_split(all_images, all_masks, test_size=0.2, random_state=42)
    train_dataset = EMDataset(train_imgs, train_masks)
    full_dataset = EMDataset(all_images, all_masks)

    train_loader = DataLoader(train_dataset, batch_size=4, shuffle=True)

    # ========== Model Configuration ==========
    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    model = UNetPlusPlus(in_ch=1, out_ch=1).to(device)
    optimizer = optim.Adam(model.parameters(), lr=1e-4)
    bce_loss = nn.BCELoss()

    best_loss = float('inf')
    patience = 5
    counter = 0

    # ========== Training process==========
    for epoch in range(100):
        model.train()
        epoch_loss = 0
        for images, masks in tqdm(train_loader, desc=f"Epoch {epoch+1} Training"):
            images = images.to(device)
            masks = masks.to(device)

            preds = model(images)
            loss = 0.5 * bce_loss(preds, masks) + 0.5 * dice_loss(preds, masks)

            optimizer.zero_grad()
            loss.backward()
            optimizer.step()

            epoch_loss += loss.item()

        avg_loss = epoch_loss / len(train_loader)
        print(f"Epoch {epoch+1} Loss: {avg_loss:.4f}")

        if avg_loss < best_loss:
            best_loss = avg_loss
            counter = 0
            torch.save(model.state_dict(), "unetpp_model.pth")
            print(f" Loss improved, model saved.")
        else:
            counter += 1
            print(f" No improvement. Patience: {counter}/{patience}")
            if counter >= patience:
                print(" Early stopping triggered.")
                break

    # ========== Load the best model and predict ==========
    model.load_state_dict(torch.load("unetpp_model.pth"))
    model.eval()

    os.makedirs("predicted_masks", exist_ok=True)
    all_preds = []
    all_masks = []
    iou_list = []

    for i in tqdm(range(len(full_dataset)), desc="Predicting"):
        image_tensor, mask_tensor = full_dataset[i]
        image_tensor = image_tensor.unsqueeze(0).to(device)
        pred = model(image_tensor)
        pred_bin = (pred.detach().cpu().numpy()[0, 0] > 0.5).astype(np.uint8)
        gt_bin = (mask_tensor.squeeze(0).numpy() > 0.5).astype(np.uint8)

        # Save Mask
        image_path = full_dataset.image_list[i]
        relative_path = os.path.relpath(image_path, image_dir)
        pred_path = os.path.join("predicted_masks", relative_path)
        os.makedirs(os.path.dirname(pred_path), exist_ok=True)
        Image.fromarray(pred_bin * 255).save(pred_path)

        all_preds.extend(pred_bin.flatten())
        all_masks.extend(gt_bin.flatten())
        iou_list.append(compute_iou(pred_bin, gt_bin))

    # ========== IOU Output ==========
    mean_iou = np.mean(iou_list)
    print(f"IOU：{mean_iou:.4f}")

    # ========== confusion matrix ==========
    cm = confusion_matrix(all_masks, all_preds)
    fig, ax = plt.subplots(figsize=(6, 6))
    cax = ax.matshow(cm, cmap='Blues')
    plt.title('Confusion Matrix')
    fig.colorbar(cax)
    ax.set_xticks([0, 1])
    ax.set_xticklabels(['Background', 'Foreground'])
    ax.set_yticks([0, 1])
    ax.set_yticklabels(['Background', 'Foreground'])
    plt.xlabel('Predicted labels')
    plt.ylabel('True labels')
    for (i, j), val in np.ndenumerate(cm):
        ax.text(j, i, val, ha='center', va='center', color='red')
    plt.tight_layout()
    plt.savefig("confusion_matrix.png")
    plt.show()

    # ========== Original Cropping ==========
    # print("Start cropping the original image according to the mask...")
    for i in range(len(full_dataset)):
        rel_path = os.path.relpath(full_dataset.image_list[i], image_dir)
        mask_path = os.path.join("predicted_masks", rel_path)
        original_path = os.path.join(original_dir, rel_path)

        if not os.path.exists(original_path) or not os.path.exists(mask_path):
            print(f"{rel_path}")
            continue

        image = Image.open(original_path).convert('RGB').resize((256, 256))
        mask = Image.open(mask_path).convert('L').resize((256, 256))

        image_np = np.array(image)
        mask_np = np.array(mask)
        mask_bin = (mask_np > 127).astype(np.uint8)
        mask_3c = np.stack([mask_bin]*3, axis=-1)
        cropped = image_np * mask_3c

        save_path = os.path.join(save_crop_dir, rel_path)
        os.makedirs(os.path.dirname(save_path), exist_ok=True)
        Image.fromarray(cropped).save(save_path)

    print(f"{save_crop_dir}，IOU：{mean_iou:.4f}")


if __name__ == "__main__":
    train()

