# 2. Image segmentation to accurately delineate the regions of interest(DeepLabV3Plus+ResNet)
## This code uses the smp library to build semantic segmentation models based on the DeepLabV3Plus architecture. It employs ResNet50 and ResNet101 as encoders respectively, aiming to perform segmentation on the dataset that has already undergone denoising.
import os
import torch
import numpy as np
import torch.nn as nn
from PIL import Image
from tqdm import tqdm
from torchvision import transforms
from torch.utils.data import Dataset, DataLoader, random_split
import segmentation_models_pytorch as smp
import albumentations as A
from albumentations.pytorch import ToTensorV2
from pathlib import Path
import matplotlib.pyplot as plt
# The pathway setting
IMAGE_DIR = Path('../../task 1 - Image denoising/EMDS5-Denoised-DnCnn')
MASK_DIR = Path('../../EMDS-6/EMDS5-Ground Truth')
NUM_CLASSES = 2
# Preprocessing Dataset
class EMDSDataset(Dataset):
    def __init__(self, image_root, mask_root, transform=None):
        self.image_root = image_root
        self.mask_root = mask_root
        self.transform = transform

        self.samples = []
        for cls_dir in sorted(self.image_root.iterdir()):
            if not cls_dir.is_dir():
                continue
            for img_path in cls_dir.glob("*.png"):
                cls = cls_dir.name
                fname = img_path.name  # e.g. EMDS5-g01-01.png
                # Convert to mask filename
                mask_name = fname.replace(".png", "-GTM.png")
                mask_path = self.mask_root / cls / mask_name
                if mask_path.exists():
                    self.samples.append((img_path, mask_path))

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        image_path, mask_path = self.samples[idx]
        image = np.array(Image.open(image_path).convert("RGB"))
        mask = np.array(Image.open(mask_path).convert("L"))
        mask = (mask == 255).astype(np.uint8)  # 255 → 1，0 Keep background value

        if self.transform:
            transformed = self.transform(image=image, mask=mask)
            image = transformed['image']
            mask = transformed['mask'].long()

        return image, mask
# Datasets augmentation
train_transform = A.Compose([
    A.Resize(256, 256),
    A.HorizontalFlip(p=0.5),
    A.RandomBrightnessContrast(p=0.2),
    A.Normalize(mean=(0.485, 0.456, 0.406),
                std=(0.229, 0.224, 0.225)),
    ToTensorV2()
])

val_transform = A.Compose([
    A.Resize(256, 256),
    A.Normalize(mean=(0.485, 0.456, 0.406),
                std=(0.229, 0.224, 0.225)),
    ToTensorV2()
])
# Loading datasets
dataset = EMDSDataset(IMAGE_DIR, MASK_DIR, transform=train_transform)
train_size = int(0.7 * len(dataset))
val_size = len(dataset) - train_size
train_dataset, val_dataset = random_split(dataset, [train_size, val_size])
val_dataset.dataset.transform = val_transform

train_loader = DataLoader(train_dataset, batch_size=8, shuffle=True)
val_loader = DataLoader(val_dataset, batch_size=8)
# model setting
model = smp.DeepLabV3Plus(
    encoder_name="resnet50",        # backbone can swap to 'resnet101' and xception
    encoder_weights="imagenet",     # using pretraining
    in_channels=3,
    classes=NUM_CLASSES
).cuda()

# Loss function and optimizer
criterion = nn.CrossEntropyLoss()
optimizer = torch.optim.Adam(model.parameters(), lr=1e-4)
# Training  + validation
def evaluate(loader):
    model.eval()
    ious, dices = [], []
    with torch.no_grad():
        for images, masks in loader:
            images, masks = images.cuda(), masks.cuda()
            outputs = model(images)
            preds = torch.argmax(outputs, dim=1)

            intersection = ((preds == masks) & (masks > 0)).sum().item()
            union = ((preds > 0) | (masks > 0)).sum().item()
            iou = intersection / union if union > 0 else 0

            dice = (2. * intersection) / (preds.numel() + masks.numel())
            ious.append(iou)
            dices.append(dice)
    return np.mean(ious), np.mean(dices)
#Strating training
best_iou = 0
for epoch in range(20):
    model.train()
    epoch_loss = 0
    for images, masks in tqdm(train_loader):
        images, masks = images.cuda(), masks.cuda()
        optimizer.zero_grad()
        outputs = model(images)
        loss = criterion(outputs, masks)
        loss.backward()
        optimizer.step()
        epoch_loss += loss.item()

    val_iou, val_dice = evaluate(val_loader)
    print(f"Epoch {epoch+1}, Loss: {epoch_loss:.4f}, Val IoU: {val_iou:.4f}, Val Dice: {val_dice:.4f}")
    if val_iou > best_iou:
        best_iou = val_iou
        torch.save(model.state_dict(), "segmentation_deeplabv3plus_resnet50.pth")
        print("Best model saved!")
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

#Testing DeepLabV3P with ResNet50 backbone
img_path = "../../task 1 - Image denoising/EMDS5-Denoised-DnCnn/06/EMDS5-g06-06.png"  # The pathway of testing image
gt_mask_path = "../../EMDS-6/EMDS5-Ground Truth/06/EMDS5-g06-06-GTM.png" # GT image
model_path = "segmentation_deeplabv3plus_resnet50.pth"   # The pathway of model

# construct model
model = smp.DeepLabV3Plus(
    encoder_name="resnet50",
    encoder_weights=None,
    in_channels=3,
    classes=2
).to(device)

model.load_state_dict(torch.load(model_path, map_location=device))
model.eval()

# Reading image and preprocessing
image = np.array(Image.open(img_path).convert("RGB"))
aug = val_transform(image=image)
input_tensor = aug['image'].unsqueeze(0).to(device)
input_tensor = input_tensor.cuda()



# Prediction
with torch.no_grad():
    output = model(input_tensor)  # [1, 2, H, W]
    pred_mask = torch.argmax(output.squeeze(), dim=0).cpu().numpy()  # [H, W]
    
# Process GT 
gt_mask = np.array(Image.open(gt_mask_path).convert("L"))
gt_mask = (gt_mask == 255).astype(np.uint8)

pred_mask_resized = np.array(
    Image.fromarray(pred_mask.astype(np.uint8)).resize((image.shape[1], image.shape[0]), resample=Image.NEAREST)
)
#Overlap on the mask
overlay = image.copy()
overlay[pred_mask_resized == 1] = [255, 0, 0]
blended = np.uint8(image * 0.5 + overlay * 0.5)

# makes results be visible
plt.figure(figsize=(12, 4))

plt.subplot(1, 3, 1)
plt.imshow(image)
plt.title("Original Image")
plt.axis("off")

plt.subplot(1, 3, 2)
plt.imshow(gt_mask, cmap='gray')
plt.title("Ground Truth Mask")
plt.axis("off")

plt.subplot(1, 3, 3)
plt.imshow(blended)
plt.title("Predicted Overlay")
plt.axis("off")

plt.tight_layout()
plt.show()
# backbone ResNet101 model setting
