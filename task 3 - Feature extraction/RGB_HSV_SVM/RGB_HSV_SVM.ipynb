3.HSV feature extraction
import os
import cv2
import glob
import numpy as np
import pandas as pd


def extract_hsv_hist_with_mask(image_path, mask_path, bins=(8, 8, 8)):
    image = cv2.imread(image_path)  # BGR
    mask = cv2.imread(mask_path, cv2.IMREAD_GRAYSCALE)

    if image is None or mask is None:
        print(f"⚠️ Unable to read image or mask：{image_path}")
        return None

    image = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
    mask = cv2.resize(mask, (image.shape[1], image.shape[0]))
    mask = (mask > 127).astype(np.uint8) * 255  # Binarization mask

    hist = cv2.calcHist([image], [0, 1, 2], mask, bins,
                        [0, 180, 0, 256, 0, 256])  # HSV Note: H range is 0-180
    hist = cv2.normalize(hist, hist).flatten()
    return hist


# def batch_extract_masked_hsv_features(image_dir="cropped_images_SPN",
def batch_extract_masked_hsv_features(image_dir="../../task 2 - Image segmentation/U-Net++/EMDS5-Unetpp-DnCnn",
                                      mask_dir="predicted_masks",
                                      bins=(8, 8, 8),
                                      output_csv="masked_hsv_features_Denoised.csv"):
    features = []
    paths = []

    image_paths = glob.glob(os.path.join(image_dir, "**", "*.png"), recursive=True)
    for img_path in image_paths:
        rel_path = os.path.relpath(img_path, image_dir)
        mask_path = os.path.join(mask_dir, rel_path)


        hist = extract_hsv_hist_with_mask(img_path, mask_path, bins)
        if hist is not None:
            features.append(hist)
            paths.append(rel_path)

    df = pd.DataFrame(features)
    df.insert(0, "image", paths)
    df.to_csv(output_csv, index=False)


if __name__ == "__main__":
    batch_extract_masked_hsv_features()

