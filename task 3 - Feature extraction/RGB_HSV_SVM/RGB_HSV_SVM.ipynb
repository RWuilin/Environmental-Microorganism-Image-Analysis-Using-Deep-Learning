## Training and Evaluation of Selected Image Classification Models

This notebook focuses on training and evaluating selected image classification models for environmental microorganism recognition.

The workflow includes:

- Preprocessing of denoised and cropped image datasets
- Implementation of specific models (e.g., ResNet-18, SimpleViT)
- Training on labeled datasets with multi-class outputs (21 classes)
- Evaluation using accuracy and F1-score
- Performance visualization for model comparison

This notebook serves as a focused subset of the broader classifier evaluation project, highlighting results from two representative model architectures.
3.RGB color feature extraction
import os
import cv2
import glob
import numpy as np
import pandas as pd


# Extract color histogram features (keep only masked white areas)
def extract_color_hist_with_mask(image_path, mask_path, bins=(8, 8, 8)):
    image = cv2.imread(image_path)  # BGR
    mask = cv2.imread(mask_path, cv2.IMREAD_GRAYSCALE)

    image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)
    mask = cv2.resize(mask, (image.shape[1], image.shape[0]))
    mask = (mask > 127).astype(np.uint8) * 255  # Binarization mask

    hist = cv2.calcHist([image], [0, 1, 2], mask, bins,
                        [0, 256, 0, 256, 0, 256])
    hist = cv2.normalize(hist, hist).flatten()
    return hist


# def batch_extract_masked_features(image_dir="cropped_images_SPN",
def batch_extract_masked_features(image_dir="../../task 2 - Image segmentation/U-Net++/EMDS5-Unetpp-DnCnn",
                                   mask_dir="predicted_masks",
                                   bins=(8, 8, 8),
                                   output_csv="masked_color_features_Denoised.csv"):
    features = []
    paths = []

    image_paths = glob.glob(os.path.join(image_dir, "**", "*.png"), recursive=True)
    for img_path in image_paths:
        rel_path = os.path.relpath(img_path, image_dir)
        mask_path = os.path.join(mask_dir, rel_path)



        hist = extract_color_hist_with_mask(img_path, mask_path, bins)
        if hist is not None:
            features.append(hist)
            paths.append(rel_path)

    df = pd.DataFrame(features)
    df.insert(0, "image", paths)
    df.to_csv(output_csv, index=False)

if __name__ == "__main__":
    batch_extract_masked_features()

