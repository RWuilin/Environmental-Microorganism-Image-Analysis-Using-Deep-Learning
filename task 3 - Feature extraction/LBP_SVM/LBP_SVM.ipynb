## Feature Extraction for Environmental Microorganism Images

This notebook performs feature extraction from environmental microorganism images to support downstream classification tasks. It includes:

- Loading of denoised and cropped image datasets
- Preprocessing and transformation of images for model compatibility
- Extracting high-level features using pre-trained CNN backbones (e.g., ResNet, EfficientNet)
- Saving extracted features to disk for reuse in classification experiments
- Optional dimensionality reduction or visualization (e.g., PCA or t-SNE)

The extracted features are designed to capture discriminative information useful for training shallow classifiers or analyzing class separability in the dataset.

# Divide the image into 8*8 blocks (after experiments, 8*8 and 16*16 data are similar, but 4*4, 32*32, and 216*216 have lower accuracy),
# Perform local binary mode on the images in the folder and save the extracted features into a CSV file
import os
import cv2
import numpy as np
import pandas as pd
from skimage.feature import local_binary_pattern

def extract_lbp_block_features(image, radius=1, n_points=8, blocks=8, method='uniform'):
    h, w = image.shape
    block_size_h = h // blocks
    block_size_w = w // blocks
    features = []
    for i in range(blocks):
        for j in range(blocks):
            block = image[i*block_size_h:(i+1)*block_size_h, j*block_size_w:(j+1)*block_size_w]
            lbp = local_binary_pattern(block, n_points, radius, method)
            n_bins = n_points + 2
            hist, _ = np.histogram(lbp.ravel(), bins=n_bins, range=(0, n_bins))
            hist = hist.astype("float") / (hist.sum() + 1e-7)
            features.extend(hist)
    return np.array(features)

data = []
root_dir = "../../task 2 - Image segmentation/U-Net++/EMDS5-Unetpp-DnCnn"

for folder in [f"{i:02d}" for i in range(1, 22)]:
    folder_path = os.path.join(root_dir, folder)
    if not os.path.isdir(folder_path):
        continue
    for file in os.listdir(folder_path):
        file_path = os.path.join(folder_path, file)
        image = cv2.imread(file_path, cv2.IMREAD_GRAYSCALE)
        if image is None:
            continue
        if image.shape != (256, 256):
            image = cv2.resize(image, (256, 256))
        features = extract_lbp_block_features(image, radius=1, n_points=8, blocks=8, method='uniform')
        record = {"folder": folder, "filename": file}
        for idx, value in enumerate(features):
            record[f"feat_{idx}"] = value
        data.append(record)

df = pd.DataFrame(data)
output_csv = "lbp_block_features.csv"
df.to_csv(output_csv, index=False)
print("Saved features for {} images to {}.".format(len(data), output_csv))

# In the experiment of classification task,
# the previously extracted LBP feature data was used to classify the microbial images using support vector machine (SVM).
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.svm import SVC
from sklearn.metrics import classification_report, confusion_matrix, accuracy_score
import matplotlib.pyplot as plt
import seaborn as sns

df = pd.read_csv("lbp_block_features.csv")

label_mapping = {
    "01": "Actinophrys",
    "02": "Arcella",
    "03": "Aspidisca",
    "04": "Codosiga",
    "05": "Colpoda",
    "06": "Epistylis",
    "07": "Euglypha",
    "08": "Paramecium",
    "09": "Rotifera",
    "10": "Vorticella",
    "11": "Noctiluca",
    "12": "Ceratium",
    "13": "Stentor",
    "14": "Siprostomum",
    "15": "Keratella Quadrala",
    "16": "Euglena",
    "17": "Gymnodinium",
    "18": "Gonyaulax",
    "19": "Phacus",
    "20": "Stylongchia",
    "21": "Synchaeta"
}
df["class_label"] = df["folder"].apply(lambda x: label_mapping[str(x).zfill(2)])

feature_cols = [col for col in df.columns if col not in ["folder", "filename", "class_label"]]
X = df[feature_cols]
y = df["class_label"]

X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, stratify=y, random_state=42)

svm_clf = SVC(kernel="rbf", C=1.0, gamma="scale")
svm_clf.fit(X_train, y_train)

y_pred = svm_clf.predict(X_test)
report = classification_report(y_test, y_pred, zero_division=0)
print("Classification Report:\n", report)

acc = accuracy_score(y_test, y_pred)
print("Overall Accuracy:", acc)

cm = confusion_matrix(y_test, y_pred, labels=list(label_mapping.values()))
plt.figure(figsize=(10,8))
sns.heatmap(cm, annot=True, fmt="d", xticklabels=list(label_mapping.values()), yticklabels=list(label_mapping.values()))
plt.xlabel("Predicted Label")
plt.ylabel("True Label")
plt.title("Confusion Matrix")
plt.tight_layout()
plt.show()
